####################################################################
# comment-to-DM — configuration
#
# Copy this file to `.env` and fill it in. `.env` is gitignored and
# must never be committed. Every value below is read once at boot;
# change one and restart the service.
#
# PowerShell:  Copy-Item .env.example .env
# bash:        cp .env.example .env
####################################################################

# --- where the service listens -------------------------------------
# Render sets PORT itself; leave it alone there.
PORT=3000
HOST=0.0.0.0
# development | test | production. `production` also marks the admin
# cookie Secure, so use it whenever you are behind HTTPS.
NODE_ENV=development


# --- database ------------------------------------------------------
# postgres | memory.  `memory` keeps everything in RAM and loses it on
# restart: fine for a local poke-around, never for real use.
REPOSITORY=postgres

# Postgres connection string. With docker-compose, this is the value
# already set in docker-compose.yml.
# Supabase: Project Settings -> Database -> Connection string -> URI,
# and use the *pooler* (port 6543) host if you are on a small plan.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/comment_to_dm

# true for Supabase / Render / Neon / any hosted Postgres.
# false for the local docker-compose database.
DATABASE_SSL=false


# --- Meta app credentials ------------------------------------------
# All four come from your own Meta app. docs/SETUP.md walks through
# getting each one. None of them belong in git, ever.

# App secret: Meta app dashboard -> App settings -> Basic -> App secret.
# Used ONLY to verify the X-Hub-Signature-256 on incoming webhooks.
APP_SECRET=

# A random string you invent. You type the same string into the
# "Verify token" box when you add the webhook callback URL in the Meta
# dashboard. It proves the GET /webhook handshake came from your app.
# Generate one:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
VERIFY_TOKEN=

# Your Instagram professional account's ID (the "app user" ID), from
# the Instagram API setup page or GET /me?fields=user_id.
IG_USER_ID=

# Long-lived Instagram User access token (60 days). Refresh it before
# it expires — see docs/OPERATIONS.md, "Token rotation".
IG_ACCESS_TOKEN=

# Graph API version to pin. v26.0 was current when this was built.
# Meta deprecates versions roughly every two years; bump deliberately,
# never automatically.
API_VERSION=v26.0

# Base host. `graph.instagram.com` is correct for Instagram API with
# Instagram Login (Business Login for Instagram), which is what this
# service is built for. Only change it if you deliberately switch to
# Facebook Login for Business (then it is graph.facebook.com).
GRAPH_BASE_URL=https://graph.instagram.com


# --- the dashboard -------------------------------------------------
# Password for /admin. Make it long and random; it is the only thing
# protecting your rules and your audience data.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=


# --- logging -------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info


# --- the safety switch ---------------------------------------------
# true  = no Meta call is ever made. Outbound messages are logged and
#         marked sent, and the whole state machine still runs. This is
#         how you rehearse. Start here.
# false = live. It will reply to real people.
DRY_RUN=true


####################################################################
# Everything below has sensible defaults. You can delete these lines.
####################################################################

# --- worker loops --------------------------------------------------
EVENT_POLL_MS=1000          # how often to look for new webhook events
OUTBOX_POLL_MS=1000         # how often to look for messages to send
EVENT_BATCH=10              # events claimed per tick
OUTBOX_BATCH=10             # outbox rows claimed per tick
MAX_ATTEMPTS=5              # delivery attempts before a row is FAILED;
                            # also the number of follow checks per person
BACKOFF_BASE_MS=2000        # first retry delay ceiling
BACKOFF_MAX_MS=300000       # retry delay ceiling cap (5 minutes)

# --- rate limiting -------------------------------------------------
# Meta's documented budget is 750 private replies per hour per account.
# 600 leaves headroom so a burst of comments cannot walk you into it.
RATE_LIMIT_PER_HOUR=600
RATE_LIMIT_BURST=20         # most calls we will make back-to-back

# --- how much we are willing to message one person -----------------
# Minutes before the same person can get another *unsolicited* first
# DM (the one triggered by a comment). Replies to their own button tap
# are never delayed by this.
CONTACT_COOLDOWN_MINUTES=10
# Hard ceiling of messages to one person in 24 h. The promised
# resource is exempt: never swallow something you said you would send.
MAX_MESSAGES_PER_CONTACT_PER_DAY=6
# Hard ceiling of messages from the account in one hour.
MAX_MESSAGES_PER_HOUR=400

# --- platform windows (do not raise these) -------------------------
# Meta allows a private reply within 7 days of the comment.
PRIVATE_REPLY_MAX_AGE_HOURS=168
# The standard messaging window a user action opens.
MESSAGING_WINDOW_HOURS=24

# --- conversation housekeeping -------------------------------------
# A tap after delivery re-sends the resource at most once per this many
# minutes.
REDELIVERY_COOLDOWN_MINUTES=10
# Conversations with no activity for this long are marked ABANDONED.
ABANDON_AFTER_HOURS=72
