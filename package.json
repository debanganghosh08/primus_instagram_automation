{
  "name": "comment-to-dm",
  "version": "1.0.0",
  "private": true,
  "description": "Instagram comment -> auto public reply -> auto DM with a follow gate, for one Instagram Professional account, using official Meta APIs only.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "main": "dist/index.js",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "simulate": "tsx src/simulate.ts",
    "migrate": "tsx src/repo/migrate-cli.ts"
  },
  "dependencies": {
    "dotenv": "17.2.3",
    "fastify": "5.12.7",
    "pg": "8.16.3",
    "pino": "9.13.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/pg": "8.15.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
